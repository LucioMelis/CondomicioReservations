#common configuration
export APP_NAME="condomicio"
export MY_ENV="local"
export COMPOSE_BASE_DIRECTORY="./"
export WEB_APP_ROOT=""

#Network
export NETWORK_NAME="${APP_NAME}_network"

#Django docker configuration
export DJANGO_SERVICE="django.${APP_NAME}"
export DJANGO_HOST="${DJANGO_SERVICE}"
export DJANGO_CONTEXT="./"
export DJANGO_DOCKERFILE="./stack/${MY_ENV}/django/Dockerfile"
export DJANGO_HOST_PORT="8000"
export DJANGO_LOCAL_PORT="8000"
export DJANGO_PORT="${DJANGO_HOST_PORT}:${DJANGO_LOCAL_PORT}/tcp"
export DJANGO_INITIAL_DATA_PATH="./${WEB_APP_ROOT}/stack/${MY_ENV}/django/initial_data/"
export DJANGO_CMD="./stack/${MY_ENV}/django/dryRun.sh"

#Dabase configuration
export DB_SERVICE="postgres.${APP_NAME}"
export DB_DOCKERFILE="Dockerfile"
export DB_CONTEXT="./stack/${MY_ENV}/postgres"
export DB_HOST="${DB_SERVICE}"
export DB_NAME="condomicio_db"
export DB_USER="condomicio_user"
export DB_PASSWORD="condomicio_pwd"
export DB_PORT="5432"
export DB_DATA_ROOT="/var/lib/postgressql/data/"